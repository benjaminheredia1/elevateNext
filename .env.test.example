# Plantilla de .env.test — BD de tests LOCAL y desechable, nunca la compartida.
# Levantar el contenedor con:
#   docker run -d --name elevate_test_pg -e POSTGRES_HOST_AUTH_METHOD=trust \
#     -e POSTGRES_DB=elevate_db_test -p 5434:5432 postgres:16-alpine
# Ojo: `npm test` corre `prisma db push` + seed contra esta URL.
DATABASE_URL="postgresql://postgres@localhost:5434/elevate_db_test"
DIRECT_URL="postgresql://postgres@localhost:5434/elevate_db_test"
SECRET_JWT="cambiar-por-un-secreto-de-pruebas"
SALT_ROUNDS=10
NEXT_PUBLIC_APP_URL="http://localhost:3000"
RESEND_API_KEY="re_tu_api_key"
RESEND_FROM_EMAIL="recuperar@resend.dev"
