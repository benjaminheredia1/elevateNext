// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  
}

enum EstadoTransaccion {
  PENDIENTE
  EN_PREPARACION
  LISTO
  EN_LOCAL
  EN_CAMINO
  LLEGO
  ENTREGADO
  CANCELADO
  PAGADO
}

// Estado de pago, independiente del estado de cumplimiento (estado)
enum EstadoPago {
  PENDIENTE
  PAGADO
  REEMBOLSADO
  COD_PENDIENTE
}

enum Rol {
  DUENO
  ADMIN
  CAJERO
  CLIENTE
}

enum AccionAuditoria {
  CREO
  MODIFICO
  ELIMINO
  LOGIN
  LOGOUT
  APERTURA_CAJA
  CIERRE_CAJA
}

enum TipoCuenta {
  EFECTIVO
  QR
  TARJETA
  BANCO
  // Pago dividido QR + efectivo (solo Transaccion.metodo_pago; el desglose
  // real vive en los MovimientoCaja hijos, que siempre son EFECTIVO o QR)
  MIXTO
}

enum EstadoTurno {
  ABIERTO
  CERRADO
}

enum TipoMovimientoCaja {
  VENTA
  INGRESO_EXTRA
  GASTO_OPERATIVO
  COMPRA_INSUMO
  AJUSTE
  RETIRO
}

enum CanalVenta {
  WEB
  PICKUP
  SALON
}

enum TipoEntrega {
  RECOJO
  DELIVERY
}

enum Frecuencia {
  MENSUAL
  QUINCENAL
  SEMANAL
  ANUAL
}

enum EstadoCuenta {
  PENDIENTE
  PARCIAL
  PAGADA
}

enum TipoCuentaCxCxP {
  POR_COBRAR
  POR_PAGAR
}

model Usuario {
  id                   Int                 @id @default(autoincrement())
  nombre               String
  apellido_paterno     String
  apellido_materno     String
  email                String              @unique
  username             String?             @unique
  password             String
  token                String
  rol                  Rol                 @default(CLIENTE)
  activo               Boolean             @default(true)
  ultimo_acceso        DateTime?
  sucursal_id          Int?
  sucursal             Sucursal?           @relation(fields: [sucursal_id], references: [id])
  transaccion_id       Transaccion[]       @relation("UsuarioTransacciones")
  transacciones_cajero Transaccion[]       @relation("CajeroTransacciones")
  turnos_caja          CajaTurno[]
  movimientos_caja     MovimientoCaja[]
  cajas                Caja[]
  auditorias           RegistroAuditoria[]
  horarios             HorarioTrabajador[]
  password_reset_tokens PasswordResetToken[]
  pagos_cuenta_corriente CuentaCorrientePago[]
  created_at           DateTime            @default(now())
  update_at            DateTime            @updatedAt
}

model PasswordResetToken {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  usuario_id Int
  usuario    Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([usuario_id])
}

model Cliente {
  id                 Int                 @id @default(autoincrement())
  nombre             String
  telefono           String?             @unique
  email              String?
  nit                String?
  direccion          String?
  es_anonimo         Boolean             @default(false)
  transacciones      Transaccion[]
  cuentas_corrientes CuentaCorriente[]
  privilegios        ClientePrivilegio[]
  created_at         DateTime            @default(now())
  update_at          DateTime            @updatedAt
}

model Privilegio {
  id            Int                 @id @default(autoincrement())
  nombre        String
  descripcion   String?
  porcentaje    Decimal             @db.Decimal(5, 2)
  activo        Boolean             @default(true)
  // Sucursal a la que aplica. NULL = privilegio del negocio, válido en todos los
  // locales. Con valor, solo descuenta en ese local: el "Staff Fitbull" no tiene
  // por qué darle descuento a alguien que compra en Sur.
  sucursal_id   Int?
  sucursal      Sucursal?           @relation(fields: [sucursal_id], references: [id])
  creado_por_id Int
  clientes      ClientePrivilegio[]
  created_at    DateTime            @default(now())
  update_at     DateTime            @updatedAt

  @@index([activo])
  @@index([sucursal_id])
}

model ClientePrivilegio {
  cliente_id    Int
  privilegio_id Int
  created_at    DateTime   @default(now())
  cliente       Cliente    @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  privilegio    Privilegio @relation(fields: [privilegio_id], references: [id], onDelete: Cascade)

  @@id([cliente_id, privilegio_id])
  @@index([privilegio_id])
}

model Transaccion {
  id         Int      @id @default(autoincrement())
  usuario_id Int?
  usuario    Usuario? @relation("UsuarioTransacciones", fields: [usuario_id], references: [id])

  cliente_id Int?
  cliente    Cliente? @relation(fields: [cliente_id], references: [id])

  cliente_nombre    String?
  cliente_telefono  String?
  cliente_direccion String?
  cliente_lat       Float?
  cliente_lng       Float?
  cliente_nit       String?
  cliente_email     String?
  tipo_entrega      TipoEntrega?
  codigo_descuento  String?
  metodo_pago       TipoCuenta?
  total             Decimal           @db.Decimal(12, 2)
  estado            EstadoTransaccion @default(PENDIENTE)
  payment_status    EstadoPago        @default(PENDIENTE)
  codigo            String?           @unique

  // Operación presencial / canal
  canal       CanalVenta?
  es_cortesia Boolean     @default(false)
  // Sucursal a la que pertenece la venta. Se escribe siempre: el POS la toma del
  // turno abierto y el checkout web de la sucursal del pedido. Antes solo se
  // podía inferir vía turno, y las ventas web (sin turno) quedaban huérfanas.
  sucursal_id Int
  sucursal    Sucursal    @relation(fields: [sucursal_id], references: [id])
  turno_id    Int?
  turno       CajaTurno?  @relation(fields: [turno_id], references: [id])
  // Numeración visible por turno: #1..#n desde cada apertura de caja (el id
  // global sigue siendo el correlativo histórico). Null en pedidos sin turno.
  numero_turno Int?
  /**
   * Correlativo propio de la sucursal: #1, #2, #3… y no reinicia nunca.
   *
   * Es el número que se le dice al cliente. El `id` es un contador compartido
   * por todo el negocio, así que una sucursal nueva arrancaba mostrando #2101
   * solo porque las otras ya habían vendido 2100 veces.
   */
  numero_sucursal Int?
  cajero_id   Int?
  cajero      Usuario?    @relation("CajeroTransacciones", fields: [cajero_id], references: [id])

  // Driver tracking fields
  driver_nombre  String?
  driver_lat     Float?
  driver_lng     Float?
  driver_link_id String? @unique

  transaccionesDetalles_id TransaccionesDetalles[]
  movimientos              MovimientoCaja[]
  movimientos_internos     MovimientoInterno[]
  cuenta_corriente         CuentaCorriente?
  created_at               DateTime                @default(now())
  update_at                DateTime                @updatedAt

  // Un mismo turno no puede repetir número de pedido (los NULL no chocan)
  @@unique([turno_id, numero_turno])
  // Ni una sucursal su correlativo: es la red que atrapa dos ventas simultáneas
  // que hubieran calculado el mismo número.
  @@unique([sucursal_id, numero_sucursal])
  @@index([sucursal_id, created_at])
}

model Categoria {
  id           Int                  @id @default(autoincrement())
  nombre       String
  detalles     String
  categoria_id CategoriasProducto[]
  created_at   DateTime             @default(now())
  update_at    DateTime             @updatedAt
}

model Producto {
  id                       Int                     @id @default(autoincrement())
  nombre                   String
  descripcion              String
  precio                   Decimal                 @db.Decimal(12, 2)
  imagen_url               String?
  disponible               Boolean                 @default(true)
  // FASE 5A — tipo, publicación, nutrición y marcas
  tipo                     ProductoTipo            @default(ELABORADO)
  estado_publicacion       EstadoPublicacion       @default(BORRADOR)
  insumo_reventa_id        Int?
  insumo_reventa           Insumo?                 @relation("InsumoReventa", fields: [insumo_reventa_id], references: [id])
  ventas_acumuladas        Int                     @default(0)
  calorias                 Int?
  proteina                 String?
  // Baja definitiva del producto (retiro del catálogo)
  motivo_baja              String?
  fecha_baja               DateTime?
  // En revisión: cuando un insumo en su receta fue dado de baja
  en_revision              Boolean                 @default(false)
  revision_desde           DateTime?
  motivo_revision          String?
  insumo_causa_revision_id Int?
  categoria_id             CategoriasProducto[]
  created_at               DateTime                @default(now())
  update_at                DateTime                @updatedAt
  recetaProducto_id        RecetasProducto[]
  promocionProducto_id     PromocionProducto[]
  transaccionesDetalles_id TransaccionesDetalles[]
  marcas                   ProductoMarca[]
  sucursales               ProductoSucursal[]
  combos                   ComboItem[]
}

model TransaccionesDetalles {
  id                Int         @id @default(autoincrement())
  transaccion_id    Int
  precio_unitario   Decimal     @db.Decimal(12, 2)
  descuentoAplicado Decimal     @default(0) @db.Decimal(12, 2)
  producto_id       Int
  cantidad          Float
  /**
   * Combo del que salió esta línea. Un combo se guarda como una línea por
   * producto componente, con el precio prorrateado y todas marcadas acá: así el
   * descuento de stock y la analítica por producto siguen andando, y se puede
   * agrupar para ver cuánto vendió cada combo.
   */
  combo_id          Int?
  combo             PromocionesDescuentos? @relation(fields: [combo_id], references: [id])
  transaccion       Transaccion @relation(fields: [transaccion_id], references: [id], onDelete: Cascade)
  producto          Producto    @relation(fields: [producto_id], references: [id])

  @@index([combo_id])
}

/**
 * Categorías de un producto. `sucursal_id` en null son las del catálogo, que
 * heredan todos los locales; si una sucursal define las suyas, esas reemplazan
 * a las del catálogo solo para ese local.
 */
model CategoriasProducto {
  id           Int       @id @default(autoincrement())
  categoria_id Int
  producto_id  Int
  sucursal_id  Int?
  categoria    Categoria @relation(fields: [categoria_id], references: [id])
  producto     Producto  @relation(fields: [producto_id], references: [id])
  sucursal     Sucursal? @relation(fields: [sucursal_id], references: [id])
  created_at   DateTime  @default(now())
  update_at    DateTime  @updatedAt

  @@unique([producto_id, categoria_id, sucursal_id])
  @@index([producto_id, sucursal_id])
}

model UnidadMedida {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now())
  update_at  DateTime @updatedAt
}

model Insumo {
  id                   Int                  @id @default(autoincrement())
  nombre               String
  stock_actual         Float
  stock_minimo         Float
  unidad_medida        String
  costo_promedio       Float                @default(0)
  es_mixto             Boolean              @default(false)
  // FASE 5A — campos de inventario avanzado
  punto_critico        Float                @default(0)
  categoria_insumo     String?
  rendimiento          Float?
  proveedor            String?
  proveedor_telefono   String?
  uso_diario_promedio  Float?
  // Baja definitiva del insumo (retiro del inventario)
  activo               Boolean              @default(true)
  fecha_baja           DateTime?
  motivo_baja          String?
  // Equivalencia informativa (ej. 1 UNIDAD = 300 GR) — no afecta stock/recetas
  equivalencia_unidad   String?
  equivalencia_cantidad Float?
  movimientoInterno_id MovimientoInterno[]
  recetaProducto_id    RecetasProducto[]
  insumos_mixtos_padre InsumoMixtoDetalle[] @relation("InsumoPadre")
  insumos_mixtos_hijo  InsumoMixtoDetalle[] @relation("InsumoHijo")
  productos_reventa    Producto[]           @relation("InsumoReventa")
  // Detalle por sucursal. stock_actual/costo_promedio de arriba quedan como
  // agregado del negocio (suma de todas las sucursales).
  stocks               StockSucursal[]
  created_at           DateTime             @default(now())
  update_at            DateTime             @updatedAt
}

model InsumoMixtoDetalle {
  id              Int    @id @default(autoincrement())
  insumo_padre_id Int
  insumo_hijo_id  Int
  cantidad        Float
  insumo_padre    Insumo @relation("InsumoPadre", fields: [insumo_padre_id], references: [id])
  insumo_hijo     Insumo @relation("InsumoHijo", fields: [insumo_hijo_id], references: [id])
}

model RecetasProducto {
  id                 Int      @id @default(autoincrement())
  producto_id        Int
  insumo_id          Int
  // Cada sucursal tiene su propia ficha técnica: mismos insumos pueden llevar
  // gramajes distintos. Al habilitar un producto en otra sucursal se copia la
  // receta de origen como punto de partida, y desde ahí es independiente.
  sucursal_id        Int
  cantidad_utilizada Float
  producto           Producto @relation(fields: [producto_id], references: [id])
  insumo             Insumo   @relation(fields: [insumo_id], references: [id])
  sucursal           Sucursal @relation(fields: [sucursal_id], references: [id])
  created_at         DateTime @default(now())
  update_at          DateTime @updatedAt

  @@unique([producto_id, insumo_id, sucursal_id])
  @@index([sucursal_id])
}

/**
 * Habilitación de un producto en una sucursal: qué vende cada local, a qué
 * precio y con qué presentación. El producto en sí (identidad y categoría) es
 * uno solo, para poder comparar su rendimiento entre sucursales.
 */
model ProductoSucursal {
  id          Int      @id @default(autoincrement())
  producto_id Int
  sucursal_id Int
  precio      Decimal  @db.Decimal(12, 2)
  disponible  Boolean  @default(true)
  // Baja lógica DE ESTE LOCAL: el producto sale de su menú sin afectar a los
  // demás, y se puede restaurar. La baja global (Producto.estado_publicacion)
  // queda para retirar el producto de todo el negocio.
  motivo_baja String?
  fecha_baja  DateTime?
  // Overrides opcionales: en null el local hereda el valor del catálogo, y si
  // más adelante se edita el catálogo el cambio le llega. En cuanto el local
  // escribe uno, ese campo queda fijo acá y ninguna edición de otra sucursal
  // (ni del catálogo) lo vuelve a tocar.
  nombre             String?
  imagen_url         String?
  descripcion        String?
  calorias           Int?
  proteina           String?
  estado_publicacion EstadoPublicacion?
  // Revisión DE ESTE LOCAL: se enciende cuando un insumo de SU receta se da de
  // baja acá. La receta es de la sucursal, así que la revisión también: que en
  // Sur falte un insumo no dice nada de la ficha de Fitbull.
  en_revision              Boolean   @default(false)
  revision_desde           DateTime?
  motivo_revision          String?
  insumo_causa_revision_id Int?
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  sucursal    Sucursal @relation(fields: [sucursal_id], references: [id])
  created_at  DateTime @default(now())
  update_at   DateTime @updatedAt

  @@unique([producto_id, sucursal_id])
  @@index([sucursal_id, disponible])
}

enum Tipo_movimiento {
  INGRESO
  EGRESO
  PRODUCCION
  VENTA
  MERMA
  AJUSTE
  BAJA
}

enum ProductoTipo {
  ELABORADO
  REVENTA
}

enum EstadoPublicacion {
  BORRADOR
  PUBLICADO
  ARCHIVADO
  BAJA
}

/**
 * Stock de un insumo en una sucursal. El insumo es un catálogo compartido
 * (nombre, unidad de medida) para que las recetas apunten al mismo ingrediente
 * en todos los locales; lo que es de cada local es cuánto tiene, a qué costo lo
 * compró y sus niveles de alerta.
 *
 * Insumo.stock_actual se mantiene como agregado de todas las sucursales: los
 * reportes globales que aún no distinguen sucursal siguen leyendo de ahí.
 */
model StockSucursal {
  id             Int      @id @default(autoincrement())
  insumo_id      Int
  sucursal_id    Int
  stock_actual   Float    @default(0)
  costo_promedio Float    @default(0)
  stock_minimo   Float    @default(0)
  punto_critico  Float    @default(0)
  // Baja DEL INSUMO EN ESTE LOCAL: deja de usarse acá sin desaparecer del
  // negocio. `Insumo.activo` queda como agregado (falso cuando ya no lo usa
  // ninguna sucursal), pero para operar manda esta fila.
  activo         Boolean  @default(true)
  fecha_baja     DateTime?
  motivo_baja    String?
  insumo         Insumo   @relation(fields: [insumo_id], references: [id], onDelete: Cascade)
  sucursal       Sucursal @relation(fields: [sucursal_id], references: [id])
  created_at     DateTime @default(now())
  update_at      DateTime @updatedAt

  @@unique([insumo_id, sucursal_id])
  @@index([sucursal_id])
}

model MovimientoInterno {
  id              Int             @id @default(autoincrement())
  insumo_id       Int
  tipo_movimiento Tipo_movimiento
  cantidad        Float
  descripcion     String
  // FASE 5A — trazabilidad extendida
  costo_unitario  Float?
  responsable     String?
  transaccion_id  Int?
  // Todo movimiento de inventario ocurre en un local concreto.
  sucursal_id     Int
  insumo          Insumo          @relation(fields: [insumo_id], references: [id])
  transaccion     Transaccion?    @relation(fields: [transaccion_id], references: [id])
  sucursal        Sucursal        @relation(fields: [sucursal_id], references: [id])
  created_at      DateTime        @default(now())
  update_at       DateTime        @updatedAt

  @@index([sucursal_id, created_at])
}

model PromocionProducto {
  id                      Int                   @id @default(autoincrement())
  producto_id             Int
  key                     String
  promocion_descuentos_id Int
  // En cascada como los items de combo: borrar la promoción debe llevarse sus
  // vínculos, que no significan nada sin ella.
  promocionDescuentos     PromocionesDescuentos @relation(fields: [promocion_descuentos_id], references: [id], onDelete: Cascade)
  producto                Producto              @relation(fields: [producto_id], references: [id])

  @@index([promocion_descuentos_id])
}

/**
 * Promoción. Dos formas, misma maquinaria de vigencia:
 *
 * - DESCUENTO: abarata productos sueltos (los de `promocionProducto_id`).
 * - COMBO: paquete vendible con sus propios items, que el cajero cobra como
 *   una sola línea. Al cobrarse se explota en sus productos, así el descuento
 *   de insumos y la analítica por producto siguen funcionando.
 */
model PromocionesDescuentos {
  id     Int    @id @default(autoincrement())
  nombre String
  /**
   * Valor histórico como texto ("20%", "5"). Se conserva porque hay filas
   * viejas; lo que manda es `tipo` + `monto`, que salieron de parsearlo.
   */
  valor  String

  tipo        TipoPromocion @default(DESCUENTO)
  modo_precio ModoPrecio    @default(PORCENTAJE)
  /** % cuando PORCENTAJE, Bs cuando MONTO_DESCUENTO o PRECIO_FIJO. */
  monto       Decimal       @default(0) @db.Decimal(12, 2)

  descripcion String?
  imagen_url  String?
  activo      Boolean @default(true)

  promocionProducto_id PromocionProducto[]
  reglasHorarias_id    ReglasHorarias[]
  items                ComboItem[]
  sucursales           PromocionSucursal[]
  detallesVenta        TransaccionesDetalles[]
  created_at           DateTime            @default(now())
  update_at            DateTime            @updatedAt @default(now())

  @@index([tipo, activo])
}

enum TipoPromocion {
  DESCUENTO
  COMBO
}

enum ModoPrecio {
  /** Descuenta un % del precio. */
  PORCENTAJE
  /** Resta un monto fijo en Bs (comportamiento de las promos viejas sin %). */
  MONTO_DESCUENTO
  /** El precio final es este monto, sin importar cuánto sumen los productos. */
  PRECIO_FIJO
}

/** Qué lleva un combo y en qué cantidad. */
model ComboItem {
  id           Int                   @id @default(autoincrement())
  promocion_id Int
  producto_id  Int
  cantidad     Float                 @default(1)
  promocion    PromocionesDescuentos @relation(fields: [promocion_id], references: [id], onDelete: Cascade)
  producto     Producto              @relation(fields: [producto_id], references: [id])

  @@unique([promocion_id, producto_id])
  @@index([producto_id])
}

/**
 * Dónde está habilitada la promoción y con qué precio. Igual que los productos
 * y los insumos: un combo de Fitbull no se vende en Sur salvo que se habilite.
 */
model PromocionSucursal {
  id           Int                   @id @default(autoincrement())
  promocion_id Int
  sucursal_id  Int
  /** Precio propio del local. En null usa el `monto` de la promoción. */
  monto        Decimal?              @db.Decimal(12, 2)
  disponible   Boolean               @default(true)
  promocion    PromocionesDescuentos @relation(fields: [promocion_id], references: [id], onDelete: Cascade)
  sucursal     Sucursal              @relation(fields: [sucursal_id], references: [id])
  created_at   DateTime              @default(now())
  update_at    DateTime              @updatedAt @default(now())

  @@unique([promocion_id, sucursal_id])
  @@index([sucursal_id, disponible])
}

/**
 * Cuándo vale una promoción: un rango de fechas MÁS una franja horaria y los
 * días de la semana. Sin franja vale todo el día, que es como se comportaban
 * las reglas anteriores a esto.
 *
 * "Todo agosto de 7:00 a 12:00" es UNA fila: antes habría necesitado 31.
 */
model ReglasHorarias {
  id                       Int                   @id @default(autoincrement())
  promocionesDescuentos_id Int
  fecha_inicio             DateTime
  fecha_fin                DateTime
  /** "HH:MM" en hora de Bolivia. null = todo el día. */
  hora_inicio              String?
  hora_fin                 String?
  /** 1=lunes … 7=domingo (ISO 8601). Vacío = todos los días. */
  dias_semana              Int[]                 @default([])
  promocionesDescuentos    PromocionesDescuentos @relation(fields: [promocionesDescuentos_id], references: [id], onDelete: Cascade)

  @@index([promocionesDescuentos_id])
}

model Configuracion {
  id              Int      @id @default(1)
  sucursal_lat    Float
  sucursal_lng    Float
  sucursal_nombre String
  // Grupo/chat de WhatsApp al que se avisan los pedidos nuevos.
  // Si whatsapp_grupo_jid es null no se notifica nada.
  whatsapp_grupo_jid    String?
  whatsapp_grupo_nombre String?
  created_at      DateTime @default(now())
  update_at       DateTime @updatedAt
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

model Caja {
  id             Int        @id @default(autoincrement())
  monto_inicial  Decimal    @default(0) @db.Decimal(12, 2)
  monto_final    Decimal?   @db.Decimal(12, 2)
  ingresos       Decimal    @default(0) @db.Decimal(12, 2)
  egresos        Decimal    @default(0) @db.Decimal(12, 2)
  estado         EstadoCaja @default(ABIERTA)
  fecha_apertura DateTime   @default(now())
  fecha_cierre   DateTime?
  usuario_id     Int
  usuario        Usuario    @relation(fields: [usuario_id], references: [id])
  gastos         Gasto[]
}

model Gasto {
  id          Int      @id @default(autoincrement())
  caja_id     Int
  monto       Decimal  @db.Decimal(12, 2)
  descripcion String
  caja        Caja     @relation(fields: [caja_id], references: [id])
  created_at  DateTime @default(now())
}

/**
 * ===== Multi-sucursal (generaliza Configuracion) =====
 */
model Sucursal {
  id         Int                @id @default(autoincrement())
  nombre     String
  direccion  String?
  lat        Float?
  lng        Float?
  activa     Boolean            @default(true)
  usuarios     Usuario[]
  cuentas      CuentaFinanciera[]
  turnos       CajaTurno[]
  diasFeriados DiaFeriado[]
  transacciones Transaccion[]
  movimientosCaja MovimientoCaja[]
  recetas      RecetasProducto[]
  productos    ProductoSucursal[]
  categoriasProducto CategoriasProducto[]
  marcasProducto     ProductoMarca[]
  promociones        PromocionSucursal[]
  stocks       StockSucursal[]
  movimientosInternos MovimientoInterno[]
  gastosFijos     GastoFijo[]
  gastosOperativos GastoOperativo[]
  activosFijos    ActivoFijo[]
  privilegios     Privilegio[]
  created_at   DateTime           @default(now())
  update_at    DateTime           @updatedAt
}

/**
 * ===== Auditoria (trazabilidad, append-only) =====
 */
model RegistroAuditoria {
  id         Int             @id @default(autoincrement())
  usuario_id Int
  rol        Rol
  accion     AccionAuditoria
  entidad    String
  entidad_id String?
  detalle    String
  monto      Decimal?        @db.Decimal(12, 2)
  ip         String?
  user_agent String?
  created_at DateTime        @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([usuario_id])
  @@index([created_at])
  @@index([entidad])
}

model GastoFijo {
  id            Int        @id @default(autoincrement())
  // Gasto fijo del local (alquiler, servicios). Cada sucursal lleva los suyos.
  sucursal_id   Int
  sucursal      Sucursal   @relation(fields: [sucursal_id], references: [id])
  concepto      String
  categoria     String
  monto         Decimal    @db.Decimal(12, 2)
  frecuencia    Frecuencia @default(MENSUAL)
  activo        Boolean    @default(true)
  creado_por_id Int
  created_at    DateTime   @default(now())
  update_at     DateTime   @updatedAt

  @@index([sucursal_id])
  @@index([activo])
  @@index([categoria])
}

model GastoOperativo {
  id            Int        @id @default(autoincrement())
  sucursal_id   Int
  sucursal      Sucursal   @relation(fields: [sucursal_id], references: [id])
  concepto      String
  categoria     String
  monto         Decimal    @db.Decimal(12, 2)
  metodo_pago   TipoCuenta
  fecha         DateTime
  notas         String?
  creado_por_id Int
  created_at    DateTime   @default(now())
  update_at     DateTime   @updatedAt

  @@index([sucursal_id])
  @@index([fecha])
  @@index([categoria])
  @@index([metodo_pago])
}

/**
 * ===== CUENTAS FINANCIERAS (Caja Efectivo / QR / Banco) =====
 */
model CuentaFinanciera {
  id          Int              @id @default(autoincrement())
  sucursal_id Int
  tipo        TipoCuenta
  nombre      String
  saldo       Decimal          @default(0) @db.Decimal(12, 2)
  sucursal    Sucursal         @relation(fields: [sucursal_id], references: [id])
  movimientos MovimientoCaja[]
  created_at  DateTime         @default(now())
  update_at   DateTime         @updatedAt

  @@unique([sucursal_id, tipo])
}

/**
 * ===== TURNO DE CAJA (apertura / cierre) =====
 */
model CajaTurno {
  id                  Int              @id @default(autoincrement())
  sucursal_id         Int
  cajero_id           Int
  estado              EstadoTurno      @default(ABIERTO)
  apertura_efectivo   Decimal          @default(0) @db.Decimal(12, 2)
  apertura_qr         Decimal          @default(0) @db.Decimal(12, 2)
  fecha_apertura      DateTime         @default(now())
  ventas_efectivo     Decimal          @default(0) @db.Decimal(12, 2)
  ventas_qr           Decimal          @default(0) @db.Decimal(12, 2)
  esperado_efectivo   Decimal?         @db.Decimal(12, 2)
  esperado_qr         Decimal?         @db.Decimal(12, 2)
  real_efectivo       Decimal?         @db.Decimal(12, 2)
  real_qr             Decimal?         @db.Decimal(12, 2)
  diferencia_efectivo Decimal?         @db.Decimal(12, 2)
  diferencia_qr       Decimal?         @db.Decimal(12, 2)
  observaciones       String?
  fecha_cierre        DateTime?
  sucursal            Sucursal         @relation(fields: [sucursal_id], references: [id])
  cajero              Usuario          @relation(fields: [cajero_id], references: [id])
  movimientos         MovimientoCaja[]
  ventas              Transaccion[]
  created_at          DateTime         @default(now())
  update_at           DateTime         @updatedAt

  @@index([sucursal_id, estado])
  @@index([fecha_apertura])
}

/**
 * ===== MOVIMIENTO DE CAJA (libro del turno) =====
 */
model CuentaCorriente {
  id             Int             @id @default(autoincrement())
  tipo           TipoCuentaCxCxP
  contraparte    String
  concepto       String
  monto          Decimal         @db.Decimal(12, 2)
  monto_pagado   Decimal         @default(0) @db.Decimal(12, 2)
  // Descuento aplicado después de crear la deuda (ej. se olvidó al vender):
  // `monto` ya lo tiene restado; aquí queda cuánto y por qué, para el historial.
  descuento        Decimal       @default(0) @db.Decimal(12, 2)
  motivo_descuento String?
  vencimiento    DateTime?
  estado         EstadoCuenta    @default(PENDIENTE)
  creado_por_id  Int
  // Relaciones opcionales para "fiado"
  cliente_id     Int?
  transaccion_id Int?            @unique
  cliente        Cliente?        @relation(fields: [cliente_id], references: [id])
  transaccion    Transaccion?    @relation(fields: [transaccion_id], references: [id])
  pagos          CuentaCorrientePago[]
  created_at     DateTime        @default(now())
  update_at      DateTime        @updatedAt

  @@index([tipo, estado])
  @@index([cliente_id])
  @@index([vencimiento])
}

/**
 * Historial de pagos de una cuenta corriente (ledger inmutable).
 * Cada cobro/abono queda registrado con método, monto, quién y cuándo;
 * `monto_pagado` de la cuenta es el acumulado derivable de estas filas.
 * `movimiento_caja_id` enlaza al libro del turno cuando el pago entró por caja
 * (null si se registró desde admin, sin turno).
 */
model CuentaCorrientePago {
  id                 Int             @id @default(autoincrement())
  cuenta_id          Int
  cuenta             CuentaCorriente @relation(fields: [cuenta_id], references: [id])
  monto              Decimal         @db.Decimal(12, 2)
  metodo_pago        TipoCuenta?
  movimiento_caja_id Int?            @unique
  movimiento_caja    MovimientoCaja? @relation(fields: [movimiento_caja_id], references: [id])
  creado_por_id      Int
  creado_por         Usuario         @relation(fields: [creado_por_id], references: [id])
  created_at         DateTime        @default(now())

  @@index([cuenta_id])
}

model ActivoFijo {
  id               Int      @id @default(autoincrement())
  sucursal_id      Int
  sucursal         Sucursal @relation(fields: [sucursal_id], references: [id])
  nombre           String
  categoria        String
  fecha_compra     DateTime
  valor_original   Decimal  @db.Decimal(12, 2)
  valor_actual     Decimal  @db.Decimal(12, 2)
  depreciacion_pct Decimal? @db.Decimal(5, 2)
  notas            String?
  activo           Boolean  @default(true)
  creado_por_id    Int
  created_at       DateTime @default(now())
  update_at        DateTime @updatedAt

  @@index([sucursal_id])
  @@index([activo])
  @@index([categoria])
}

model MovimientoCaja {
  id             Int                @id @default(autoincrement())
  // Sucursal del movimiento. Se guarda explícita porque no todo movimiento
  // tiene turno (gastos y ajustes fuera de caja), y sin ella el flujo de caja
  // filtrado por sucursal los perdía.
  sucursal_id    Int
  turno_id       Int?
  cuenta_id      Int
  tipo           TipoMovimientoCaja
  metodo_pago    TipoCuenta
  monto          Decimal            @db.Decimal(12, 2)
  concepto       String
  categoria      String?
  transaccion_id Int?
  es_cortesia    Boolean            @default(false)
  creado_por_id  Int
  created_at     DateTime           @default(now())

  sucursal    Sucursal         @relation(fields: [sucursal_id], references: [id])
  turno       CajaTurno?       @relation(fields: [turno_id], references: [id])
  cuenta      CuentaFinanciera @relation(fields: [cuenta_id], references: [id])
  transaccion Transaccion?     @relation(fields: [transaccion_id], references: [id])
  creado_por  Usuario          @relation(fields: [creado_por_id], references: [id])
  pago_cuenta_corriente CuentaCorrientePago?

  @@index([turno_id])
  @@index([created_at])
  @@index([tipo, metodo_pago])
  @@index([sucursal_id, created_at])
}

// ===== FASE 5A — Inventario avanzado =====

model Marca {
  id         Int             @id @default(autoincrement())
  key        String          @unique // "elevate" | "fitbull"
  nombre     String
  color      String?
  productos  ProductoMarca[]
  created_at DateTime        @default(now())
  update_at  DateTime        @updatedAt
}

/** Marcas del producto. Misma regla que las categorías: null = catálogo. */
model ProductoMarca {
  id          Int      @id @default(autoincrement())
  producto_id Int
  marca_id    Int
  sucursal_id Int?
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  marca       Marca    @relation(fields: [marca_id], references: [id], onDelete: Cascade)
  sucursal    Sucursal? @relation(fields: [sucursal_id], references: [id])

  @@unique([producto_id, marca_id, sucursal_id])
  @@index([producto_id, sucursal_id])
}

model ConfiguracionAlertas {
  id                   Int      @id @default(1)
  whatsapp_habilitado  Boolean  @default(false)
  destinatarios        String[] @default([])
  hora_silencio_desde  String   @default("22:00")
  hora_silencio_hasta  String   @default("07:00")
  intervalo_minimo_min Int      @default(60)
  plantilla_mensaje    String   @default("Elevate - Alerta de inventario: {count} insumos bajo umbral.\n{list}")
  created_at           DateTime @default(now())
  update_at            DateTime @updatedAt
}

model RegistroAlerta {
  id         Int      @id @default(autoincrement())
  enviado_at DateTime @default(now())
  canal      String   @default("whatsapp")
  insumo_ids Int[]    @default([])
  estado     String // sent | failed | simulated
  preview    String
}

model HorarioTrabajador {
  id           Int      @id @default(autoincrement())
  usuario_id   Int
  dia_semana   Int      // 1=lunes ... 7=domingo (ISO 8601)
  es_libre     Boolean  @default(false)
  hora_entrada String?  // "HH:MM", null cuando es_libre = true
  hora_salida  String?  // "HH:MM", null cuando es_libre = true
  usuario      Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())
  update_at    DateTime @updatedAt

  @@unique([usuario_id, dia_semana])
}

model DiaFeriado {
  id          Int       @id @default(autoincrement())
  fecha       DateTime  @db.Date
  nombre      String
  sucursal_id Int?
  sucursal    Sucursal? @relation(fields: [sucursal_id], references: [id])
  created_at  DateTime  @default(now())

  @@unique([fecha, sucursal_id])
}

model WhatsappMessage { 
  id          Int       @id @default(autoincrement())
  phoneNumber String
  content     String
  timestamp   DateTime  @default(now())
  created_at  DateTime  @default(now())
}